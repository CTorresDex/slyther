class SlytherScript
class SlytherArtifact {
    Represents an instantiated artifact defined in an SlytherScript, contains:

    - artifact: The kind of the artifact, ex. class, function, etc...
    - name: The name of the artifact to be created
    - content: The prose written inside the artifact
    - hash: The hash of all the fields above
}

class ParsedSlytherScript {
    Represents a parsed SlytherScript, contains:

    - artifacts: A list of SlytherArtifacts that were parsed from the SlytherScript
}

class SlytherParser {
    Reads a SlytherScript and returns a ParsedSlytherScript
}

