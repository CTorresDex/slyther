@import "./project.sly"
@use Compiler

command parse {
    Input: input file, defaults to main.sly

    Parses the input file and prints the JSON representation of the result #{ParsedSlytherScript}
}

command kinds {
    Input: input file, defaults to main.sly

    Parses the input file and prints the JSON representation of every #{SlytherArtifactKind} it defines, and prints its warnings to stderr
}

command init {
    Initializes a #{Project::SlytherProject} in the current directory with the
    #{Project::SlytherProject::init} method and prints what it created
}

command build {
    Input: the --max and --verbose flags

    Compiles the current #{Project::SlytherProject} using the #{Project::SlytherProject::build} method, prints
    what it did to every file and what happened to every instance with its errors, an emitted instance
    indented under its parent, and exits 1 when any instance fails or is missing
}

command run {
    Input: the name of the script, and its args in order

    Runs a script of the project using the #{Project::SlytherProject::run} method and exits with its code. The
    first arg is the name of the script when a script of that name is built, otherwise every arg belongs
    to the default script
}

command op {
    Input: the kind, the operation, its args in order, and the --execute flag

    Runs the operation using the #{Project::SlytherProject::runOperation} method: prints what it returns and exits with
    its code. With --execute, an operation that is not deterministic runs through a #{Build::ClaudeCLIGenerator}
}
command check {
    Input: the --max and --verbose flags

    Checks the current #{Project::SlytherProject} using the #{Project::SlytherProject::check} method, without
    touching its code, prints what happened to every instance with its errors, an emitted instance indented
    under its parent, and exits 1 when any fails or is missing
}
