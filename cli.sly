@import "./project.sly"
@use Compiler

command parse {
    Input: input file, defaults to main.sly

    Parses the input file and prints the JSON representation of the result #{ParsedSlytherScript}
}

command kinds {
    Input: input file, defaults to main.sly

    Parses the input file and prints the JSON representation of every #{SlytherArtifactKind} it defines, and prints its warnings to stderr
}

command init {
    Initializes a #{Project::SlytherProject} in the current directory
}

command build {
    Builds the current #{Project::SlytherProject} using the #{Project::SlytherProject::build} method and prints
    what it did to every file
}

command run {
    Input: the kind, the operation, its args in order, and the --execute flag

    Runs the operation using the #{Project::SlytherProject::run} method: prints what it returns and exits with
    its code. With --execute, an operation that is not deterministic runs through a #{Build::ClaudeCLIGenerator}
}
command check {
    Input: the --fix and --max flags

    Checks the current #{Project::SlytherProject} using the #{Project::SlytherProject::check} method, prints what
    happened to every artifact with its errors, and exits 1 when any fails or is missing
}
