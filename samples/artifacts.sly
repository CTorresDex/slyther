@lang "ts"

@artifact class (requirements: string) {
    Every class lives at src/src/classes/{name}.class.ts, where name is the id written in PascalCase, and
    holds only the minimum amount of code to fulfill its requirements, following the YAGNI principle.

    rule single-definition: deterministic {
        The file has only one top level definition, the class. No helper functions, no types, no variables
        on the top level.
    }

    rule shape: deterministic {
        The class strictly follows this shape:
        ```ts
        // Imports

        export class {name (PascalCase)} {
            // class definition
        }
        ```
    }

    rule helper-outside: negative {
        Breaks #{class::single-definition} and #{class::shape}: a helper next to the class.
        ```ts
        // Imports

        function helper(): void {}

        export class Thing {
            run(): void { helper(); }
        }
        ```
    }

    rule scoped-methods {
        The functions defined in the class are only from the scope of the class: any general purpose
        utility function must be defined at the respective utils class called by the name of the type
        (StringUtils, FunctionUtils, NumberUtils, etc...)
    }

    operation locate: deterministic {
        Prints src/src/classes/{name}.class.ts and exits 0 if the file exists, otherwise prints nothing and exits 1.
    }

    operation create {
        deterministic scaffold (lang: "ts") {
            Scaffolds the class with the shape #{class::shape} gives, exits 1 if it already exists.
        }

        llm requirements {
            Implements the requirements in the class.
        }
    }

}
